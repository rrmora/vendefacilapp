# Variables de entorno - VendeFacil AI
# No commitear valores reales ni secretos.

# --- Interruptores de IA ---
# AI_ENABLED=false sirve el modo mock y no accede a Supabase ni a proveedores.
AI_ENABLED=false
# Segunda barrera: sin true, el flujo real responde 503.
AI_REAL_CALLS_ENABLED=false

# --- Limites y presupuesto ---
AI_GLOBAL_TIMEOUT_MS=25000
AI_MONTHLY_BUDGET_USD=5
AI_MAX_TOKENS_DEFAULT_INPUT=400
AI_MAX_TOKENS_DEFAULT_OUTPUT=200

# --- Proveedores de IA (secretos solo en el servidor) ---
AI_GEMINI_API_KEY=
# AI_GEMINI_ENABLED=true
# AI_GEMINI_MODEL=gemini-2.5-flash
# AI_GEMINI_PRIORITY=1

AI_GROQ_API_KEY=
# AI_GROQ_ENABLED=true
# AI_GROQ_MODEL=llama-3.3-70b-versatile
# AI_GROQ_PRIORITY=2

# OpenAI es de pago y requiere habilitacion explicita ademas de la API key.
AI_OPENAI_API_KEY=
AI_OPENAI_ENABLED=false
# AI_OPENAI_MODEL=gpt-4o-mini
# AI_OPENAI_PRIORITY=3

# --- Supabase (persistencia de cuota, rate limit y presupuesto) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Red ---
# En Vercel, antes de habilitar llamadas reales, revisar la estrategia de IP/proxy.
TRUST_PROXY=false

# --- Reglas ---
# - Nunca commitear valores reales.
# - No usar NEXT_PUBLIC_ para claves ni para la autorizacion de IA.
# - Para habilitar llamadas reales en Production se requieren AI_ENABLED=true y AI_REAL_CALLS_ENABLED=true.
# - Preview y Development deben permanecer en modo mock.
